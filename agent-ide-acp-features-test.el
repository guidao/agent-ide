(ert-deftest agent-ide-acp-image-draft-submission-and-image-only-prompt ()
  (agent-ide-acp-test--session
   (let ((attachment (agent-ide-attachment-add session agent-ide-acp-test--png "screenshot.png")) sent)
     (should (string-match-p "screenshot.png" (overlay-get (agent-ide-session-input-overlay session) 'before-string)))
     (cl-letf (((symbol-function 'agent-ide-protocol-send-request)
                (lambda (_session request &rest _) (setq sent request))))
       (agent-ide-submit))
     (let ((prompt (agent-ide--get-in sent '(:params prompt))))
       (should (= (length prompt) 1))
       (should (equal (map-elt (aref prompt 0) 'type) "image"))
       (should (equal (base64-decode-string (map-elt (aref prompt 0) 'data)) agent-ide-acp-test--png)))
     (should-not (agent-ide-attachment-list session))
     (should-not (overlay-get (agent-ide-session-input-overlay session) 'before-string))
     (should (string-match-p "screenshot.png" (buffer-string)))
     (should attachment))))


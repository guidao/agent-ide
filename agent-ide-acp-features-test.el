       (agent-ide-transcript-handle-notification session '((method . "$/cancel_request") (params . ((requestId . 10)))))
       (should (equal (agent-ide--get-in (car responses) '(:result action)) "cancel"))
       (agent-ide-transcript-handle-request session (agent-ide-acp-test--form 11))
       (agent-ide-elicitation-finish session (gethash 11 (agent-ide-elicitation--table session)) "decline")
       (should (equal (agent-ide--get-in (car responses) '(:result action)) "decline"))

(defconst agent-ide-acp-test--fixture
  (expand-file-name "test/fixtures/acp-features-agent.py"
                    (file-name-directory (or load-file-name buffer-file-name))))

(defun agent-ide-acp-test--wait (predicate)
  (let ((deadline (+ (float-time) 5)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.02))
    (should (funcall predicate))))

(ert-deftest agent-ide-acp-real-process-config-images-questions-and-cancellation ()
  (skip-unless (executable-find "python3"))
  (let* ((directory (make-temp-file "agent-ide-features-" t))
         (state-file (expand-file-name "state.json" directory))
         (agent-ide-command (list (executable-find "python3") "-u" agent-ide-acp-test--fixture state-file))
         (agent-ide-environment nil) (agent-ide-model nil)
         (agent-ide--sessions nil) (agent-ide-sidebar-auto-show nil)
         (agent-ide--session-metadata (make-hash-table :test 'eq))
         session)
    (unwind-protect
        (cl-letf (((symbol-function 'agent-ide--display-buffer) #'ignore))
          (setq session (agent-ide--start-session directory))
          (agent-ide-acp-test--wait (lambda () (equal (agent-ide-session-status session) "idle")))
          (should (= (length (agent-ide-config-options session)) 2))
          (agent-ide-config-set session "flag" nil)
          (agent-ide-acp-test--wait
           (lambda () (not (map-elt (car (agent-ide-config-options session)) 'currentValue))))
          (agent-ide-attachment-add session agent-ide-acp-test--png "test.png")
          (agent-ide-deliver-prompt session "Describe this image")
          (agent-ide-acp-test--wait
           (lambda () (and (agent-ide-renderer-pending-permission session)
                           (gethash 701 (agent-ide-elicitation--table session)))))
          (should (equal (agent-ide--session-title session) "Image discussion"))
          (agent-ide-protocol-cancel session)
          (agent-ide-acp-test--wait (lambda () (equal (agent-ide-session-status session) "idle")))
          (with-temp-buffer
            (insert-file-contents state-file)
            (let* ((state (json-parse-buffer :object-type 'alist :false-object :false :array-type 'list))
                   (requests (map-elt state 'requests))
                   (prompt (seq-find (lambda (r) (equal (map-elt r 'method) "session/prompt")) requests))
                   (config (seq-find (lambda (r) (equal (map-elt r 'method) "session/set_config_option")) requests)))
              (should (eq (agent-ide--get-in config '(params value)) :false))
              (should (equal (mapcar (lambda (c) (map-elt c 'type)) (agent-ide--get-in prompt '(params prompt)))
                             '("text" "image")))
              (should (= (length (map-elt state 'responses)) 2))
              (should (equal (agent-ide--get-in (car (map-elt state 'responses)) '(result outcome outcome)) "cancelled"))
              (should (equal (agent-ide--get-in (cadr (map-elt state 'responses)) '(result action)) "cancel")))))
      (when session
        (agent-ide--cleanup-session session)
        (when (buffer-live-p (agent-ide-session-buffer session)) (kill-buffer (agent-ide-session-buffer session))))
      (delete-directory directory t))))

(ert-deftest agent-ide-acp-reconnect-preserves-id-text-and-images-without-active-turn ()
  (agent-ide-acp-test--session
   (agent-ide-renderer-replace-current-input session "draft  \n")
   (agent-ide-attachment-add session agent-ide-acp-test--png "draft.png")
   (let ((old-client (agent-ide-session-client session))
         (new-client (list (cons :new t)))
         (id (agent-ide-session-acp-session-id session))
         (images (agent-ide-attachment-list session))
         shutdown)
     (cl-letf (((symbol-function 'agent-ide--display-buffer) #'ignore)
               ((symbol-function 'acp-shutdown) (lambda (&rest _) (setq shutdown t)))
               ((symbol-function 'agent-ide--make-client) (lambda (_) new-client))
               ((symbol-function 'agent-ide--subscribe-client) #'ignore)
               ((symbol-function 'agent-ide-protocol-initialize) (lambda (_session ready) (funcall ready)))
               ((symbol-function 'agent-ide-protocol-restore-session)
                (lambda (s) (setf (agent-ide-session-status s) "idle"))))
       (setf (agent-ide-session-status session) "running")
       (should-error (agent-ide-reconnect) :type 'user-error)
       (should (eq old-client (agent-ide-session-client session)))
       (should-not shutdown)
       (setf (agent-ide-session-status session) "idle")
       (agent-ide-reconnect)
       (should shutdown)
       (should (eq new-client (agent-ide-session-client session)))
       (should (equal id (agent-ide-session-acp-session-id session)))
       (should (equal (agent-ide-renderer-current-input session t) "draft  \n"))
       (should (eq images (agent-ide-attachment-list session)))))))


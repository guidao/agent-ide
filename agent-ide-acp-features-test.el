(ert-deftest agent-ide-acp-config-boolean-grouped-values-and-complete-update ()
  (agent-ide-acp-test--session
   (agent-ide-config-update session
                            [((id . "flag") (name . "Flag") (type . "boolean") (currentValue . t))
                             ((id . "model") (name . "Model") (type . "select") (category . "model")
                              (currentValue . "a")
                              (options . [((group . "recommended") (name . "Recommended")
                                           (options . [((value . "a") (name . "A")) ((value . "b") (name . "B"))]))]))])
   (should (= 2 (length (agent-ide-config-choices (agent-ide-config-category session "model")))))
   (let (sent)
     (cl-letf (((symbol-function 'agent-ide-protocol-send-request)
                (lambda (_session request &rest callbacks)
                  (setq sent request)
                  (funcall (plist-get callbacks :on-success)
                           '((configOptions . [((id . "flag") (name . "Flag") (type . "boolean") (currentValue . nil))]))))))
       (agent-ide-config-set session "flag" nil))
     (should (eq (agent-ide--get-in sent '(:params value)) :false))
     (should (equal (agent-ide--get-in sent '(:params type)) "boolean"))
     (should (string-match-p "false" (json-serialize (map-elt sent :params))))
     (should (= (length (agent-ide-config-options session)) 1))
     (should-not (agent-ide-config-category session "model")))))


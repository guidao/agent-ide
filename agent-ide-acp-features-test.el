;;; agent-ide-acp-features-test.el --- ACP UI and lifecycle regression tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'agent-ide)

(defmacro agent-ide-acp-test--session (&rest body)
  (declare (indent 0))
  `(with-temp-buffer
     (agent-ide-session-mode)
     (let* ((agent-ide--session-metadata (make-hash-table :test 'eq))
            (agent-ide--sessions nil)
            (session (agent-ide--make-session
                      :buffer (current-buffer) :directory default-directory
                      :tool-calls (make-hash-table :test 'equal) :client (list (cons :fake t))
                      :acp-session-id "test" :initialized t :status "idle"
                      :capabilities '((promptCapabilities . ((image . t)))))))
       (setq-local agent-ide--session session)
       (agent-ide--session-metadata-put session :command '("test-agent"))
       (agent-ide-renderer-initialize-buffer session)
       (agent-ide-renderer-create-prompt session)
       (unwind-protect (progn ,@body)
         (agent-ide-elicitation-discard session)))))

(defun agent-ide-acp-test--permission (id)
  `((id . ,id) (method . "session/request_permission")
    (params . ((sessionId . "test")
               (toolCall . ((toolCallId . ,(format "tool-%s" id)) (title . "Run test")))
               (options . [((optionId . "allow") (kind . "allow_once") (name . "Allow"))])))))

(defun agent-ide-acp-test--form (id)
  `((id . ,id) (method . "elicitation/create")
    (params . ((sessionId . "test") (mode . "form") (message . "Choose approach")
               (requestedSchema . ((type . "object")
                                   (properties . ((strategy . ((type . "string") (enum . ["safe" "fast"]) (default . "safe")))
                                                  (count . ((type . "integer") (minimum . 0) (default . 0)))
                                                  (enabled . ((type . "boolean") (default . nil)))
                                                  (note . ((type . "string")))))
                                   (required . ["strategy" "count" "enabled"])))))))

(defconst agent-ide-acp-test--png
  (base64-decode-string "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jL1kAAAAASUVORK5CYII="))

(ert-deftest agent-ide-acp-context-survives-end-turn-accounting ()
  (agent-ide-acp-test--session
   (let (success)
     (cl-letf (((symbol-function 'agent-ide-protocol-send-request)
                (lambda (_session _request &rest callbacks)
                  (setq success (plist-get callbacks :on-success)))))
       (agent-ide-protocol-send-prompt session "test"))
     (agent-ide-transcript-handle-notification
      session '((method . "session/update")
                (params . ((sessionId . "test")
                           (update . ((sessionUpdate . "usage_update")
                                      (used . 53000) (size . 200000)))))))
     (funcall success '((stopReason . "end_turn") (usage . ((totalTokens . 500000)))))
     (should (string-match-p "context left: 74%" (agent-ide-renderer--header-summary session)))
     ;; Compaction can reduce context usage independently of cumulative tokens.
     (agent-ide-transcript-handle-notification
      session '((method . "session/update")
                (params . ((sessionId . "test")
                           (update . ((sessionUpdate . "usage_update")
                                      (used . 20000) (size . 200000)))))))
     (should (string-match-p "context left: 90%" (agent-ide-renderer--header-summary session))))))

(ert-deftest agent-ide-acp-context-requires-valid-capacity ()
  (dolist (usage '(nil ((totalTokens . 10)) ((used . 10) (size . 0))
                  ((used . -1) (size . 100)) ((used . "10") (size . 100))))
    (should-not (agent-ide-renderer--context-label usage)))
  (should (equal (agent-ide-renderer--context-label '((used . 0) (size . 100)))
                 "context left: 100%"))
  (should (equal (agent-ide-renderer--context-label '((used . 101) (size . 100)))
                 "context left: 0%")))

(ert-deftest agent-ide-acp-initialization-advertises-implemented-capabilities ()
  (let* ((request (agent-ide-protocol-initialize-request))
         (wire (json-parse-string (json-serialize (map-elt request :params)) :object-type 'alist)))
    (should (map-contains-key (agent-ide--get-in wire '(clientCapabilities elicitation)) 'form))
    (should-not (map-contains-key (agent-ide--get-in wire '(clientCapabilities elicitation)) 'url))
    (should (map-contains-key (agent-ide--get-in wire '(clientCapabilities session configOptions)) 'boolean))))

(ert-deftest agent-ide-acp-cancel-resolves-all-permissions-once ()
  (agent-ide-acp-test--session
   (setf (agent-ide-session-status session) "running"
         (agent-ide-session-active-requests session) '(((:method . "session/prompt"))))
   (let (responses)
     (cl-letf (((symbol-function 'acp-send-response) (lambda (&rest args) (push (plist-get args :response) responses)))
               ((symbol-function 'acp-send-notification) #'ignore))
       (agent-ide-transcript-handle-request session (agent-ide-acp-test--permission 0))
       (agent-ide-transcript-handle-request session (agent-ide-acp-test--permission 2))
       (agent-ide-protocol-cancel session)
       (agent-ide-protocol-cancel session)
       (should (= (length responses) 2))
       (should-not (agent-ide-renderer-pending-permission session))
       (dolist (response responses)
         (should (equal (agent-ide--get-in response '(:result outcome outcome)) "cancelled")))
       ;; Even a late approval during cancellation is answered immediately.
       (agent-ide-transcript-handle-request session (agent-ide-acp-test--permission 3))
       (should (= (length responses) 3))
       (should-not (agent-ide-renderer-pending-permission session))))))


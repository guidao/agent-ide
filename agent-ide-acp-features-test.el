(ert-deftest agent-ide-acp-elicitation-form-review-types-and-exactly-once ()
  (agent-ide-acp-test--session
   (let (responses record)
     (cl-letf (((symbol-function 'acp-send-response) (lambda (&rest args) (push (plist-get args :response) responses)))
               ((symbol-function 'pop-to-buffer) #'ignore))
       (agent-ide-transcript-handle-request session (agent-ide-acp-test--form 10))
       (setq record (gethash 10 (agent-ide-elicitation--table session)))
       (should record)
       (should-not responses)
       (agent-ide-elicitation-open session record)
       (should (buffer-live-p (plist-get record :buffer)))
       (let ((fields (plist-get record :fields)))
         (with-current-buffer (plist-get record :buffer)
           (widget-value-set (nth 2 (assoc "strategy" fields)) "fast")
           (agent-ide-elicitation--submit session record fields)))
       (let ((content (agent-ide--get-in (car responses) '(:result content))))
         (should (equal (gethash "strategy" content) "fast"))
         (should (equal (gethash "count" content) 0))
         (should (eq (gethash "enabled" content) :false))
         (should-not (gethash "note" content))
         (should (string-match-p "false" (json-serialize content))))
       (should-error (agent-ide-elicitation-finish session record "accept"))
       (should (= (length responses) 1))))))


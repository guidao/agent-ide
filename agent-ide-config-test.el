;;; agent-ide-config-test.el --- Configuration completion tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'agent-ide-config)

(ert-deftest agent-ide-config-completion-keeps-labels-short-and-values-exact ()
  (let* ((option '((name . "Model") (type . "select") (currentValue . "b")
                   (options . [((group . "one") (name . "Recommended")
                                (options . [((value . "a") (name . "Shared") (description . "A long\n  description"))]))
                               ((group . "two") (name . "Other")
                                (options . [((value . "b") (name . "Shared"))]))])))
         (rows (agent-ide-config--value-rows option)))
    (should (equal (mapcar (lambda (r) (plist-get r :label)) rows) '("Shared [a]" "Shared [b]")))
    (should (equal (agent-ide-config-label option) "Shared"))
    (should (equal (plist-get (car rows) :description) "A long description"))
    (cl-letf (((symbol-function 'completing-read)
               (lambda (_prompt table _predicate require-match _initial _history default &rest _)
                 (should require-match)
                 (should (equal default "Shared [b]"))
                 (let* ((metadata (completion-metadata "" table nil))
                        (affix (completion-metadata-get metadata 'affixation-function))
                        (group (completion-metadata-get metadata 'group-function)))
                   (should (eq (completion-metadata-get metadata 'display-sort-function) 'identity))
                   (should (equal (funcall group "Shared [a]" nil) "Recommended"))
                   (should (equal (funcall group "Shared [a]" t) "Shared [a]"))
                   (should (equal (nth 1 (cadr (funcall affix '("Shared [a]" "Shared [b]")))) "* ")))
                 "Shared [a]")))
      (should (equal (agent-ide-config-read-value option) "a")))))

(ert-deftest agent-ide-config-completion-annotations-align-and-fit ()
  (let ((rows '((:label "Model" :detail "6 Astra" :description "Model used for subsequent turns")
                (:label "Reasoning effort" :detail "High" :description "Long description that should be clipped to the window width"))))
    (cl-letf (((symbol-function 'window-body-width) (lambda (&rest _) 62)))
      (let* ((affixes (agent-ide-config--affix rows '("Model" "Reasoning effort") nil))
             (lines (mapcar (lambda (r) (concat (nth 1 r) (car r) (nth 2 r))) affixes)))
        (should (cl-every (lambda (line) (<= (string-width line) 58)) lines))
        (should (= (string-match "6 Astra" (car lines)) (string-match "High" (cadr lines))))
        (should (= (string-match "Model used" (car lines)) (string-match "Long description" (cadr lines))))
        (should (string-suffix-p "…" (cadr lines)))))))

(ert-deftest agent-ide-config-completion-preserves-boolean-false ()
  (let ((option '((name . "Fast mode") (type . "boolean") (currentValue . nil))))
    (should (equal (agent-ide-config-label option) "Off"))
    (cl-letf (((symbol-function 'completing-read)
               (lambda (_prompt _table _predicate _match _initial _history default &rest _)
                 (should (equal default "Off")) "Off")))
      (should (eq (agent-ide-config-read-value option) :false)))))

(provide 'agent-ide-config-test)

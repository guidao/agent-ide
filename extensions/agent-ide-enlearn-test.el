(ert-deftest agent-ide-enlearn-interrupt-cancels-coaching ()
  (with-temp-buffer
    (agent-ide-session-mode)
    (let* ((session (agent-ide-submit-test--session))
           (protocol-cancel-called nil)
           (agent-ide-enlearn-auto-send nil))
      (unwind-protect
          (progn
            (setq-local agent-ide--session session)
            (agent-ide-renderer-initialize-buffer session)
            (agent-ide-renderer-create-prompt session)
            (goto-char (marker-position (agent-ide-session-input-start-marker session)))
            (insert "帮我写测试")
            (agent-ide-enlearn-mode 1)
            (cl-letf (((symbol-function 'agent-ide-protocol-cancel)
                       (lambda (&rest _args) (setq protocol-cancel-called t)))
                      ((symbol-function 'agent-ide-enlearn--request)
                       (lambda (&rest _) nil)))
              (agent-ide-submit)
              (should (equal (agent-ide-session-status session) "coaching"))
              (should (agent-ide-enlearn--pending-for session))
              (agent-ide-interrupt)
              (should (not protocol-cancel-called))
              (should (null (agent-ide-enlearn--pending-for session)))
              (should (equal (agent-ide-session-status session) "idle")))
        (agent-ide-enlearn-mode -1))))))


(ert-deftest agent-ide-enlearn-stale-callback-ignored-after-cancel ()
  (with-temp-buffer
    (agent-ide-session-mode)
    (let* ((session (agent-ide-submit-test--session))
           (sent 'unset)
           (late-callback nil)
           (agent-ide-enlearn-auto-send nil)
           (fake-raw "## Final\nPlease write tests\n\n## Breakdown\n- x\n\n## Grammar\n- y\n"))
      (unwind-protect
          (progn
            (setq-local agent-ide--session session)
            (agent-ide-renderer-initialize-buffer session)
            (agent-ide-renderer-create-prompt session)
            (goto-char (marker-position (agent-ide-session-input-start-marker session)))
            (insert "帮我写测试")
            (agent-ide-enlearn-mode 1)
            (cl-letf (((symbol-function 'agent-ide-protocol-send-prompt)
                       (lambda (_s p) (setq sent p)))
                      ((symbol-function 'agent-ide-enlearn--request)
                       (lambda (session _mode _text)
                         (let ((request-id (plist-get (agent-ide-enlearn--pending-for session)
                                                      :request-id)))
                           (setq late-callback
                                 (lambda ()
                                   (agent-ide-enlearn--handle-response
                                    session fake-raw request-id)))))
              (agent-ide-submit)
              (should (functionp late-callback))
              (agent-ide-enlearn-cancel)
              (funcall late-callback)
              (should (eq sent 'unset))
              (should (not (string-match-p "✦ English Coach" (buffer-string))))))
        (agent-ide-enlearn-mode -1)))))))


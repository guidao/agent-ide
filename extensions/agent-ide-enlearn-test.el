(ert-deftest agent-ide-enlearn-skip-next-bypasses ()
  (with-temp-buffer
    (agent-ide-session-mode)
    (let* ((session (agent-ide-submit-test--session))
           (sent nil)
           (requested nil))
      (unwind-protect
          (progn
            (setq-local agent-ide--session session)
            (agent-ide-renderer-initialize-buffer session)
            (agent-ide-renderer-create-prompt session)
            (goto-char (marker-position (agent-ide-session-input-start-marker session)))
            (insert "plain english please")
            (agent-ide-enlearn-mode 1)
            (setq agent-ide-enlearn--skip-next t)
            (cl-letf (((symbol-function 'agent-ide-protocol-send-prompt)
                       (lambda (_s p) (setq sent p)))
                      ((symbol-function 'agent-ide-enlearn--request)
                       (lambda (&rest _) (setq requested t))))
              (agent-ide-submit)
              (should (equal sent "plain english please"))
              (should (null requested)))
        (agent-ide-enlearn-mode -1))))))

(ert-deftest agent-ide-enlearn-backend-error-abort-shows-actions ()
  (with-temp-buffer
    (agent-ide-session-mode)
    (let* ((session (agent-ide-submit-test--session))
           (agent-ide-enlearn-on-backend-error 'abort))
      (unwind-protect
          (progn
            (setq-local agent-ide--session session)
            (agent-ide-renderer-initialize-buffer session)
            (agent-ide-renderer-create-prompt session)
            (goto-char (marker-position (agent-ide-session-input-start-marker session)))
            (insert "帮我写测试")
            (agent-ide-enlearn-mode 1)
            (cl-letf (((symbol-function 'agent-ide-protocol-send-prompt)
                       (lambda (&rest _) (error "should not send")))
                      ((symbol-function 'agent-ide-enlearn--request)
                       (lambda (session &rest _)
                         (agent-ide-enlearn--render-error session "boom"))))
              (agent-ide-submit)
              (should (string-match-p "Retry" (buffer-string)))
              (should (string-match-p "Send original" (buffer-string)))
              (should (string-match-p "Cancel" (buffer-string))))
        (agent-ide-enlearn-mode -1))))))

